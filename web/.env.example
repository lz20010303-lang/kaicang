# 运行模式：mock（默认，无需密钥）| testnet | live
MODE=mock

# 交易对，仅在此配置，界面不可改
SYMBOL=BTCUSDT

# 监听地址与端口（0.0.0.0 便于同一 Wi-Fi 下的手机访问）
HOST=0.0.0.0
PORT=8787

# 可选：设置后，调用 API 需提供该令牌（请求头 X-App-Token 或页面上的访问令牌）
# APP_TOKEN=          # 可选；默认不开，任何人都能打开页面
# RATE_LIMIT_PER_MINUTE=240
# RATE_LIMIT_WRITE_PER_MINUTE=30
# MAX_CLIENTS=2000

# 模拟模式的初始余额（USDT）。仅在尚无本地台账时生效。
MOCK_BALANCE=1000

# testnet / live 才需要。只开合约交易权限，关闭提现，并设置 IP 白名单。
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# 实盘必须同时显式设置为 yes，否则程序拒绝启动。切勿默认开启。
# ALLOW_LIVE=no


# 指标参数（仅配置/环境变量可改，交易操作区没有这些旋钮）
# 均线默认 SMA20（收盘价）；Supertrend 默认 ATR 周期 10、乘数 3
# MA_PERIOD=20
# SUPERTREND_ATR_PERIOD=10
# SUPERTREND_MULTIPLIER=3

# MACD 参数（仅配置/环境变量可改；只做页面参考，不影响开单）
# 标准 MACD(12,26,9)，EMA；小级别背驰回看最近约 100 根已收盘 K 线
# MACD_FAST=12
# MACD_SLOW=26
# MACD_SIGNAL=9
# MACD_DIVERGENCE_LOOKBACK=100
